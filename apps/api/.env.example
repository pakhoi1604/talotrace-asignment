DATABASE_URL=sqlite:///./data/app.db
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
UPLOAD_DIR=./uploads
MAX_AUDIO_BYTES=26214400
DATA_PACK_DIR=../../business-systems-pack
WEB_BASE_URL=http://localhost:3000

# MOCK sign-in: the only HR account. Change for any shared setup.
HR_EMAIL=hr@example.com
HR_PASSWORD=hr-demo-password
HR_SESSION_TTL_HOURS=12
# Set true when serving over HTTPS.
HR_COOKIE_SECURE=false

# Scorer + worker (defaults match code; override only to tune).
SCORER_MAX_CALLS=3
SCORER_TIMEOUT_SECONDS=30
SCORER_BACKOFF_SECONDS=2
SCORER_MAX_OUTPUT_TOKENS=512
WORKER_MAX_CLAIMS=3
WORKER_POLL_SECONDS=2
WORKER_MIN_CALL_INTERVAL_SECONDS=4
WORKER_LEASE_SECONDS=120
WORKER_MAX_RATE_LIMIT_PAUSE_SECONDS=300
